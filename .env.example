# Copy to .env (git-ignored). No secrets are needed for Phase 1.
# Refresh job connection (login role that is a member of fr_writer)
FR_DATABASE_URL=postgresql://fr_refresh@localhost:5432/fr
# Gates
FR_MAX_SOURCE_AGE_HOURS=24
FR_MAX_DATA_ISSUE_RATIO=0.10
FR_RETENTION_RUNS=50
# Tests: superuser connection used to create a throw-away database per test session
FR_TEST_ADMIN_DSN=postgresql://postgres@localhost:5432/postgres
