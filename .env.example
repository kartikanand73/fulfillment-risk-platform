# Copy to .env (git-ignored). No secrets are needed for Phase 1.
# Refresh job connection (login role that is a member of fr_writer)
FR_DATABASE_URL=postgresql://fr_refresh@localhost:5432/fr
# Gates
FR_MAX_SOURCE_AGE_HOURS=24
FR_MAX_DATA_ISSUE_RATIO=0.10
FR_RETENTION_RUNS=50
# Tests: superuser connection used to create a throw-away database per test session
FR_TEST_ADMIN_DSN=postgresql://postgres@localhost:5432/postgres

# ---- Phase 5: live sources (non-secret; secrets come from Key Vault) ----
FR_KEYVAULT_URL=https://<vault>.vault.azure.net/
SALESFORCE_MY_DOMAIN=https://<mydomain>.my.salesforce.com
SALESFORCE_CLIENT_ID=<connected app consumer key>
SALESFORCE_SECRET_NAME=salesforce-client-secret
# SALESFORCE_TIER_FIELD=Tier__c            # optional; default derives tier from NumberOfEmployees
# SALESFORCE_ACCOUNT_FILTER=Type = 'Customer'
DATABRICKS_HOST=https://adb-<id>.<n>.azuredatabricks.net
DATABRICKS_WAREHOUSE_ID=<sql warehouse id>
FR_DATABRICKS_VIEW=skillagent.sales.v_open_order_lines
SNOWFLAKE_ACCOUNT_URL=https://<account>.snowflakecomputing.com
FR_SNOWFLAKE_TABLE=SUPPLY_CHAIN_DEMO.INVENTORY.INVENTORY_POSITION
FR_SNOWFLAKE_WAREHOUSE=FR_READER_WH
FR_SNOWFLAKE_ROLE=FR_READER
FR_SNOWFLAKE_SECRET_NAME=snowflake-fr-pat
