{
  "version": "2.0",
  "extensionBundle": { "id": "Microsoft.Azure.Functions.ExtensionBundle", "version": "[4.*, 5.0.0)" },
  "extensions": {
    "eventHubs": { "maxEventBatchSize": 100, "minEventBatchSize": 1, "maxWaitTime": "00:00:05",
                   "batchCheckpointFrequency": 1, "prefetchCount": 300,
                   "initialOffsetOptions": { "type": "fromEnd" } }
  },
  "logging": {
    "logLevel": { "default": "Information", "Host.Results": "Information", "Function": "Information" },
    "applicationInsights": { "samplingSettings": { "isEnabled": false } }
  }
}
